PORT=4000
NODE_ENV=development
HOST=0.0.0.0
WEB_APP_URL=http://localhost:5173

# Database (Neon PostgreSQL connection pool string)
DATABASE_URL=postgresql://user:password@endpoint-pooler.region.aws.neon.tech/neondb?sslmode=require

# Clerk (Admin Authentication)
CLERK_SECRET_KEY=sk_test_...
CLERK_PUBLISHABLE_KEY=pk_test_...

# Paystack (Payments)
PAYSTACK_SECRET_KEY=sk_test_...
PAYSTACK_WEBHOOK_SECRET=...

# Cloudflare R2 (Media Storage)
R2_ACCOUNT_ID=...
R2_ACCESS_KEY_ID=...
R2_SECRET_ACCESS_KEY=...
R2_BUCKET_NAME=hourlane-products
R2_PUBLIC_URL=https://pub-xxxx.r2.dev

# Resend (Transactional Email)
RESEND_API_KEY=re_...
EMAIL_FROM_ADDRESS=orders@your-domain.com
